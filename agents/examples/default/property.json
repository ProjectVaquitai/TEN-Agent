{
  "_ten": {
    "predefined_graphs": [
      {
        "name": "Kid",
        "auto_start": true,
        "nodes": [
          {
            "type": "extension",
            "name": "agora_rtc",
            "addon": "agora_rtc",
            "extension_group": "default",
            "property": {
              "app_id": "${env:AGORA_APP_ID}",
              "token": "<agora_token>",
              "channel": "ten_agent_test",
              "stream_id": 1234,
              "remote_stream_id": 123,
              "subscribe_audio": true,
              "publish_audio": true,
              "publish_data": true,
              "enable_agora_asr": true,
              "agora_asr_vendor_name": "microsoft",
              "agora_asr_language": "zh-CN",
              "agora_asr_vendor_key": "${env:AZURE_STT_KEY|}",
              "agora_asr_vendor_region": "${env:AZURE_STT_REGION|}",
              "agora_asr_session_control_file_path": "session_control.conf",
              "subscribe_video_pix_fmt": 4,
              "subscribe_video": true,
              "max_memory_length": 10
            }
          },
          {
            "type": "extension",
            "name": "llm",
            "addon": "bedrock_llm_python",
            "extension_group": "chatgpt",
            "property": {
              "access_key_id": "${env:AWS_ACCESS_KEY_ID}",
              "greeting": "我是奶龙，你有什么需要帮助吗？",
              "max_memory_length": 10,
              "max_tokens": 256,
              "model": "us.amazon.nova-lite-v1:0",
              "prompt": "给你播放手机中的视频，你需要沉浸到视频中，假设你就是身处视频场景中的陪伴机器人，不要说屏幕外的任何场景，不要说“手机”，“屏幕”等词汇，当你观察到儿童的某些行为或情绪变化时，你需要主动和他进行互动，帮助儿童调节情绪、激发兴趣或提供适当的指导。你的互动内容需要亲切、富有创造力，且符合儿童的认知和情感需求。请用“你”或“我”第一人称和小朋友或视频中的大人进行交互，语言简洁。",
              "region": "us-east-2",
              "secret_access_key": "${env:AWS_SECRET_ACCESS_KEY}",
              "temperature": 0.7,
              "topK": 10,
              "topP": 0.5,
              "is_memory_enabled": true,
              "is_enable_video": true
            }
          },
          {
            "type": "extension",
            "name": "tts",
            "addon": "fish_audio_tts",
            "extension_group": "tts",
            "property": {
              "api_key": "${env:FISH_AUDIO_TTS_KEY}",
              "model_id": "3d1cb00d75184099992ddbaf0fdd7387",
              "optimize_streaming_latency": true,
              "request_timeout_seconds": 30,
              "base_url": "https://api.fish.audio"
            }
          },
          {
            "type": "extension",
            "name": "interrupt_detector",
            "addon": "interrupt_detector_python",
            "extension_group": "default",
            "property": {}
          },
          {
            "type": "extension",
            "name": "message_collector",
            "addon": "message_collector",
            "extension_group": "transcriber",
            "property": {}
          }
        ],
        "connections": [
          {
            "extension": "agora_rtc",
            "cmd": [
              {
                "name": "on_user_joined",
                "dest": [
                  {
                    "extension": "llm"
                  }
                ]
              },
              {
                "name": "on_user_left",
                "dest": [
                  {
                    "extension": "llm"
                  }
                ]
              },
              {
                "name": "on_connection_failure",
                "dest": [
                  {
                    "extension": "llm"
                  }
                ]
              }
            ],
            "video_frame": [
              {
                "name": "video_frame",
                "dest": [
                  {
                    "extension": "llm"
                  }
                ]
              }
            ],
            "data": [
              {
                "name": "text_data",
                "dest": [
                  {
                    "extension": "interrupt_detector"
                  },
                  {
                    "extension": "message_collector"
                  }
                ]
              }
            ]
          },
          {
            "extension": "llm",
            "cmd": [
              {
                "name": "flush",
                "dest": [
                  {
                    "extension": "tts"
                  }
                ]
              }
            ],
            "data": [
              {
                "name": "text_data",
                "dest": [
                  {
                    "extension": "tts"
                  },
                  {
                    "extension": "message_collector"
                  }
                ]
              }
            ]
          },
          {
            "extension": "message_collector",
            "data": [
              {
                "name": "data",
                "dest": [
                  {
                    "extension": "agora_rtc"
                  }
                ]
              }
            ]
          },
          {
            "extension": "tts",
            "cmd": [
              {
                "name": "flush",
                "dest": [
                  {
                    "extension": "agora_rtc"
                  }
                ]
              }
            ],
            "audio_frame": [
              {
                "name": "pcm_frame",
                "dest": [
                  {
                    "extension": "agora_rtc"
                  }
                ]
              }
            ]
          },
          {
            "extension": "interrupt_detector",
            "cmd": [
              {
                "name": "flush",
                "dest": [
                  {
                    "extension": "llm"
                  }
                ]
              }
            ],
            "data": [
              {
                "name": "text_data",
                "dest": [
                  {
                    "extension": "llm"
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "log_level": 3
  }
}